[Unit]
Description=TikTok monitoring API (provides vlc_links)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/.openclaw/workspace/tiktok-live-app
ExecStart=/usr/bin/python3 app.py
Restart=on-failure
RestartSec=5
User=openclaw
Group=openclaw
Environment=PORT=5001

[Install]
WantedBy=multi-user.target
