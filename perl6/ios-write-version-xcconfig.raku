#!/usr/bin/env raku
# abstraction-provenance: {"artifact_sha256": "bd7e3d4480678e12c5818aad9f045162300fc1b2ba3170a626c6927f18745cbc", "source_sha256": "779b7d985508a28f1c672dcadb10442a6e3617e0483211b2f1764c195887e483", "target_language": "perl6"}
# ios-write-version-xcconfig.sh — portiert nach perl6
# Quelle: shell, workspace@local:skills/github-clones/openclaw/scripts/ios-write-version-xcconfig.sh
# Erzeugt: 2026-11-20 durch ABSTRACTIONS_MANAGER.py

use v6;

sub usage() {
    say q:to/EOF/;
    Usage:
      scripts/ios-write-version-xcconfig.sh [--build-number 7]

    Writes apps/ios/build/Version.xcconfig from apps/ios/version.json:
    - OPENCLAW_IOS_VERSION = exact canonical iOS version
    - OPENCLAW_MARKETING_VERSION = short iOS/App Store version
    - OPENCLAW_BUILD_VERSION = explicit build number or local numeric fallback
    EOF
}

my $root-dir = $*PROGRAM.parent.parent.IO.realpath;
my $ios-dir = $root-dir.child('apps/ios');
my $build-dir = $ios-dir.child('build');
my $version-xcconfig = $build-dir.child('Version.xcconfig');
my $version-helper = $root-dir.child('scripts/ios-version.ts');
my $ios-version = '';
my $marketing-version = '';
my $build-number = '';

sub prepare-build-dir() {
    if $build-dir.l {
        die "Refusing to use symlinked build directory: $build-dir";
    }

    $build-dir.mkdir;
}

sub write-generated-file($output-path, $content) {
    if $output-path.l {
        die "Refusing to overwrite symlinked file: $output-path";
    }

    my $tmp-file = $output-path.IO.tempfile;
    $tmp-file.print($content);
    $tmp-file.copy($output-path);
}

my $args = @*ARGS;
while $args.elems > 0 {
    my $arg = $args.shift;
    given $arg {
        when '--' {
            last;
        }
        when '--build-number' {
            $build-number = $args.shift // '';
        }
        when '-h' | '--help' {
            usage();
            exit 0;
        }
        default {
            die "Unknown argument: $arg";
        }
    }
}

my $version-data = run('node', '--import', 'tsx', $version-helper, '--shell', :dir($root-dir)).out;
for $version-data.lines -> $line {
    my ($key, $value) = $line.split('=', 2);
    given $key {
        when 'OPENCLAW_IOS_VERSION' {
            $ios-version = $value;
        }
        when 'OPENCLAW_MARKETING_VERSION' {
            $marketing-version = $value;
        }
    }
}

if $ios-version eq '' || $marketing-version eq '' {
    die "Unable to resolve iOS version metadata from $root-dir/apps/ios/version.json.";
}

if $build-number eq '' {
    $build-number = run('git', 'rev-list', '--count', 'HEAD', :dir($root-dir)).out.chomp // '0';
}

unless $build-number ~~ /^ <[0..9]>+ $/ {
    die "Invalid build number '$build-number'. Expected digits only.";
}

prepare-build-dir();

my $content = qq:to/EOF/;
    // Auto-generated by scripts/ios-write-version-xcconfig.sh.
    // Local version override; do not commit.
    OPENCLAW_IOS_VERSION = $ios-version
    OPENCLAW_MARKETING_VERSION = $marketing-version
    OPENCLAW_BUILD_VERSION = $build-number
    EOF

write-generated-file($version-xcconfig, $content);

say "Prepared iOS version settings: ios=$ios-version marketing=$marketing-version build=$build-number";
