# abstraction-provenance: {"artifact_sha256": "736413fc08f00220bfb43db96df3c47f94ceb60d7a1a4e4c90164db6a71b4eb1", "source_sha256": "352a1a62b1c8b533aa384124a35c3fda205031de642b3e77616b5f8618f2b813", "target_language": "perl6"}
