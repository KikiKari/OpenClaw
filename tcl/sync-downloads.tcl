#!/usr/bin/env tclsh
# sync-downloads.py — portiert nach tcl
# Quelle: python, Projects@TikTok-Live-Companion:site/scripts/sync-downloads.py
# auch in: Projects@vercel/install-and-configure-vercel-s-8vf8rt:site/scripts/sync-downloads.py
# Erzeugt: 2026-10-23 durch ABSTRACTIONS_MANAGER.py

# Install a prepared artifact set and derive the site's checksums from its bytes.
package require sha256
package require zipfile::decode
package require fileutil

# Parse command line arguments
if {$argc != 2 || [lindex $argv 0] ne "--from-dir"} {
    puts stderr "Usage: $argv0 --from-dir <directory>"
    exit 1
}
set fromDir [lindex $argv 1]

# Get site directory (two levels up from this script)
set scriptDir [file normalize [file dirname $argv0]]
set site [file dirname [file dirname $scriptDir]]

# Read version from manifest
set manifestPath [file join [file dirname $site] plugin-source browser-extension manifest.json]
if {![file exists $manifestPath]} {
    error "Manifest file not found: $manifestPath"
}
set manifestContent [read [set fp [open $manifestPath r]]]
close $fp
set manifest [json::json2dict $manifestContent]
set version [dict get $manifest version]

# Define artifact names
set names {}
foreach {kind suffix} {extension {} plugin {} service {} android -source ios -source} {
    lappend names "tiktok-live-companion-$kind-$version$suffix.zip"
}

# Check for APK file
set apkName "tiktok-live-companion-android-$version.apk"
if {[file exists [file join $fromDir $apkName]]} {
    lappend names $apkName
}

# Validate ZIP files
foreach name $names {
    set src [file join $fromDir $name]
    if {![string match *.zip $name]} continue
    
    if {[catch {zipfile::decode::verify $src} result]} {
        error "Corrupt ZIP: $name"
    }
    
    # Check manifest version for extension
    if {[string match *extension* $name]} {
        set manifestData [zipfile::decode::getfile $src manifest.json]
        set zipManifest [json::json2dict $manifestData]
        set zipVersion [dict get $zipManifest version]
        if {$zipVersion ne $version} {
            error "Manifest version mismatch"
        }
    }
}

# Copy files to downloads directory
set downloadDir [file join $site public downloads]
file mkdir $downloadDir
foreach name $names {
    set src [file join $fromDir $name]
    set dest [file join $downloadDir $name]
    file copy -force $src $dest
}

# Generate SHA256 hashes
set hashes ""
foreach name $names {
    set filePath [file join $downloadDir $name]
    set fp [open $filePath r]
    fconfigure $fp -translation binary
    set content [read $fp]
    close $fp
    set hash [sha256::sha256 -hex $content]
    append hashes "$hash  $name\n"
}

# Write checksum file
set checksumFile [file join $downloadDir "tiktok-live-companion-$version-SHA256.txt"]
set fp [open $checksumFile w]
puts $fp $hashes
close $fp

# Write TypeScript file
set tsFile [file join $site src download-checksums.ts]
set fp [open $tsFile w]
puts $fp "// Generated by site/scripts/sync-downloads.py; do not edit by hand."
puts $fp "export const downloadChecksums = [subst {$hashes}];"
close $fp

# Print hashes
puts $hashes

# Load JSON package
package require json

# Note: This implementation assumes the following packages are available:
# - sha256 (for SHA256 hashing)
# - zipfile::decode (for ZIP file handling)
# - fileutil (for file operations)
# - json (for JSON parsing)

# If these packages are not available, they may need to be installed via:
# package require Tclx
# or downloaded from https://core.tcl-lang.org/
