#!/usr/bin/env tclsh
# abstraction-provenance: {"artifact_sha256": "208d416db639919ea325f8fa7b253d761b273ec26b633cd7be09f803272909bc", "source_sha256": "779b7d985508a28f1c672dcadb10442a6e3617e0483211b2f1764c195887e483", "target_language": "tcl"}
# ios-write-version-xcconfig.sh — portiert nach tcl
# Quelle: shell, workspace@local:skills/github-clones/openclaw/scripts/ios-write-version-xcconfig.sh
# Erzeugt: 2026-11-20 durch ABSTRACTIONS_MANAGER.py

proc usage {} {
    puts {Usage:
  scripts/ios-write-version-xcconfig.tcl [--build-number 7]

Writes apps/ios/build/Version.xcconfig from apps/ios/version.json:
- OPENCLAW_IOS_VERSION = exact canonical iOS version
- OPENCLAW_MARKETING_VERSION = short iOS/App Store version
- OPENCLAW_BUILD_VERSION = explicit build number or local numeric fallback}
}

set ROOT_DIR [file normalize [file join [file dirname [info script]] ..]]
set IOS_DIR [file join $ROOT_DIR apps ios]
set BUILD_DIR [file join $IOS_DIR build]
set VERSION_XCCONFIG [file join $IOS_DIR build Version.xcconfig]
set VERSION_HELPER [file join $ROOT_DIR scripts ios-version.ts]
set IOS_VERSION ""
set MARKETING_VERSION ""
set BUILD_NUMBER ""

proc prepare_build_dir {} {
    global BUILD_DIR
    
    if {[file type $BUILD_DIR] eq "link"} {
        puts stderr "Refusing to use symlinked build directory: $BUILD_DIR"
        exit 1
    }
    
    file mkdir $BUILD_DIR
}

proc write_generated_file {output_path content} {
    if {[file exists $output_path] && [file type $output_path] eq "link"} {
        puts stderr "Refusing to overwrite symlinked file: $output_path"
        exit 1
    }
    
    set tmp_file [file tempfile tmp $output_path.]
    set fh [open $tmp_file w]
    puts $fh $content
    close $fh
    file rename -force $tmp_file $output_path
}

set args $argv
while {[llength $args] > 0} {
    set arg [lindex $args 0]
    switch -exact -- $arg {
        "--" {
            set args [lrange $args 1 end]
        }
        "--build-number" {
            if {[llength $args] >= 2} {
                set BUILD_NUMBER [lindex $args 1]
                set args [lrange $args 2 end]
            } else {
                set BUILD_NUMBER ""
                set args [lrange $args 1 end]
            }
        }
        "-h" - "--help" {
            usage
            exit 0
        }
        default {
            puts stderr "Unknown argument: $arg"
            usage
            exit 1
        }
    }
}

set p [open |[list node --import tsx $VERSION_HELPER --shell] r]
while {[gets $p line] != -1} {
    if {[regexp {^([^=]+)=(.*)$} $line -> key value]} {
        switch -exact -- $key {
            "OPENCLAW_IOS_VERSION" {
                set IOS_VERSION $value
            }
            "OPENCLAW_MARKETING_VERSION" {
                set MARKETING_VERSION $value
            }
        }
    }
}
close $p

if {$IOS_VERSION eq "" || $MARKETING_VERSION eq ""} {
    puts stderr "Unable to resolve iOS version metadata from [file join $ROOT_DIR apps ios version.json]."
    exit 1
}

if {$BUILD_NUMBER eq ""} {
    if {[catch {exec git rev-list --count HEAD} result] == 0} {
        set BUILD_NUMBER $result
    } else {
        set BUILD_NUMBER "0"
    }
}

if {![regexp {^[0-9]+$} $BUILD_NUMBER]} {
    puts stderr "Invalid build number '$BUILD_NUMBER'. Expected digits only."
    exit 1
}

prepare_build_dir

set content "// Auto-generated by scripts/ios-write-version-xcconfig.tcl.
// Local version override; do not commit.
OPENCLAW_IOS_VERSION = $IOS_VERSION
OPENCLAW_MARKETING_VERSION = $MARKETING_VERSION
OPENCLAW_BUILD_VERSION = $BUILD_NUMBER"

write_generated_file $VERSION_XCCONFIG $content

puts "Prepared iOS version settings: ios=$IOS_VERSION marketing=$MARKETING_VERSION build=$BUILD_NUMBER"
