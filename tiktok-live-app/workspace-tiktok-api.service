[Unit]
Description=TikTok monitoring API (provides vlc_links)
After=network.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/.openclaw/workspace/tiktok-live-app
ExecStart=/usr/local/bin/tiktok-api-launch.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
Environment=PORT=5001

[Install]
WantedBy=multi-user.target
