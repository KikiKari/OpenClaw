# =====================================================
# KRITISCH: Tipp-Unfälle mit Secrets - NIEMALS pushen
# Greift in JEDEM Unterverzeichnis durch führendes "**/"
# =====================================================
**/sud
**/pws
**/env
**/pwd
**/which
**/echo
sud
pws
env
pwd
which
echo

